# 이 파일은 커밋 대상입니다. 실제 키는 절대 여기에 넣지 마세요.
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채우세요.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_SCREENING_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-5

# ---- 공개 배포용 남용·비용 방어 (선택. 미설정 시 아래 기본값) ----
# IP당 시간당 감사 요청 수
RATE_LIMIT_PER_HOUR=3
# 하루에 판별할 수 있는 총 도구 수. 소진되면 데모 결과로 폴백됩니다.
DAILY_TOOL_BUDGET=200
# 동시 실행 작업 수 (Render 무료: 0.1 vCPU 이므로 낮게 유지)
MAX_CONCURRENT_JOBS=2
# 요청 본문 최대 크기(bytes)
MAX_BODY_BYTES=262144
